{
  "name": "@jinamem/mcp",
  "version": "0.1.0",
  "description": "MCP server \u2014 gives your AI agent persistent memory across sessions",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "jinamem-mcp": "./dist/cli.js",
    "jinamem-hook": "./dist/hook.js",
    "jinamem-setup": "./dist/setup.js",
    "jinamem-watch": "./dist/watch.js",
    "jinamem-run": "./dist/run.js",
    "jinamem-ci": "./dist/ci-cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/cli.js",
    "prepack": "cp ../../README.md ../../LICENSE .",
    "test": "tsc && node --test dist/*.test.js"
  },
  "dependencies": {
    "@jinamem/core": "^0.1.0",
    "@modelcontextprotocol/sdk": "^1.0.4",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.3.3"
  },
  "license": "MIT",
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "keywords": [
    "mcp",
    "memory",
    "agent",
    "claude",
    "cursor",
    "ai",
    "llm"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jinaico/jinamem.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://github.com/jinaico/jinamem#readme",
  "bugs": {
    "url": "https://github.com/jinaico/jinamem/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
