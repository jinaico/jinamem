{
  "name": "@jinamem/mcp",
  "version": "0.1.0",
  "description": "MCP server — gives your AI agent persistent memory across sessions",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "jinamem-mcp":   "./dist/cli.js",
    "jinamem-hook":  "./dist/hook.js",
    "jinamem-setup": "./dist/setup.js",
    "jinamem-watch": "./dist/watch.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/cli.js"
  },
  "dependencies": {
    "@jinamem/core": "*",
    "@modelcontextprotocol/sdk": "^1.0.4",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.3.3"
  },
  "license": "MIT",
  "keywords": [
    "mcp", "memory", "agent", "claude", "cursor", "ai", "llm"
  ]
}
