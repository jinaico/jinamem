# jinamem cloud — copy to .env and fill in

# Postgres password (choose something strong)
POSTGRES_PASSWORD=change_me_strong_password

# JWT secret for session tokens (generate with: openssl rand -hex 32)
JWT_SECRET=change_me_jwt_secret

# Public URL of the API server (used in MCP config returned to new users)
PUBLIC_URL=https://jinamem.dev

# Port to expose the API on (default 3001)
PORT=3001
